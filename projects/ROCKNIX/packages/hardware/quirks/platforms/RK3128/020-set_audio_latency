# Use the same guard as SM8250 before common startup supplies its 32 ms default.
. /etc/profile.d/001-functions

AUDIO_LATENCY=$(get_setting audiolatency)
if [ -z "${AUDIO_LATENCY}" ]
then
  set_setting global.audiolatency 64
fi
