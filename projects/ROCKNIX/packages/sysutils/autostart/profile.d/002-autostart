### Apply device quirks
if [ -e "/sys/firmware/devicetree/base/model" ]
then
  export QUIRK_DEVICE="$(tr -d '\000' </sys/firmware/devicetree/base/model)"
else
  export QUIRK_DEVICE="$(cat /sys/class/dmi/id/sys_vendor) $(cat /sys/class/dmi/id/product_name)"
fi
export QUIRK_DEVICE="$(echo ${QUIRK_DEVICE} | sed -e "s#[/]#-#g")"
