--- a/libretro.cpp
+++ b/libretro.cpp
@@ -251,7 +251,7 @@ static NO_INLINE uint16 ReadXPSTTS(v810_timestamp_t &timestamp, uint32 A)
 
    /* Cheap checks first; the registers only when they pass. */
    if (IdlePoll.valid && IdlePoll.pc == pc && IdlePoll.value == value &&
-       IdlePoll.writes == MemWriteCount && !memcmp(IdlePoll.regs, regs, sizeof(IdlePoll.regs)))
+       IdlePoll.writes == MemWriteCount + VB_V810->DataFastWrites && !memcmp(IdlePoll.regs, regs, sizeof(IdlePoll.regs)))
    {
