       v810_timestamp_t limit = VB_V810->GetEventNT();
@@ -271,7 +271,7 @@ static NO_INLINE uint16 ReadXPSTTS(v810_timestamp_t &timestamp, uint32 A)
    IdlePoll.valid  = true;
    IdlePoll.pc     = pc;
    IdlePoll.value  = value;
-   IdlePoll.writes = MemWriteCount;
+   IdlePoll.writes = MemWriteCount + VB_V810->DataFastWrites;
