+
+// xBRF reads at most kPad (2) pixels around each pixel, so a rectangle scaled
+// with a 2-pixel border of its real neighbours gives the same inner pixels as
+// the whole picture: only changed rectangles are worked out.
+#include "presentation/enhance/xbrf.hpp"
+
+#define FORBIDDEN_SYMBOL_ALLOW_ALL
+#include "graphics/scaler/xbrf.h"
+
+namespace {
+
+const int kBorder = 2;
+
+template<typename Pixel>
+void toRGBA(const Graphics::PixelFormat &format, const uint8 *src, uint32 srcPitch,
+            int w, int h, std::vector<std::uint8_t> &rgba) {
+	std::uint8_t *out = rgba.data();
+	for (int y = 0; y < h; ++y) {
+		const Pixel *row = reinterpret_cast<const Pixel *>(src + y * srcPitch);
+		for (int x = 0; x < w; ++x, out += 4) {
+			format.colorToRGB(row[x], out[0], out[1], out[2]);
+			out[3] = 255;
+		}
+	}
+}
+
+template<typename Pixel>
+void fromRGBA(const Graphics::PixelFormat &format, const std::vector<std::uint8_t> &rgba, int outW,
+              int skip, uint8 *dst, uint32 dstPitch, int w, int h) {
+	for (int y = 0; y < h; ++y) {
+		const std::uint8_t *in = &rgba[((y + skip) * outW + skip) * 4];
+		Pixel *row = reinterpret_cast<Pixel *>(dst + y * dstPitch);
+		for (int x = 0; x < w; ++x, in += 4)
+			row[x] = format.RGBToColor(in[0], in[1], in[2]);
+	}
+}
+
+} // End of anonymous namespace
+
+void XBRFScaler::scaleIntern(const uint8 *srcPtr, uint32 srcPitch,
+                             uint8 *dstPtr, uint32 dstPitch, int width, int height, int x, int y) {
+	const int bpp = _format.bytesPerPixel;
+	const int inW = width + 2 * kBorder, inH = height + 2 * kBorder;
+	const uint8 *corner = srcPtr - kBorder * srcPitch - kBorder * bpp;
+	std::vector<std::uint8_t> rgba(static_cast<size_t>(inW) * inH * 4);
+	if (bpp == 2)
+		toRGBA<uint16>(_format, corner, srcPitch, inW, inH, rgba);
+	else
+		toRGBA<uint32>(_format, corner, srcPitch, inW, inH, rgba);
+
+	const int f = _factor;
+	const std::vector<std::uint8_t> out = enhance::xbrf_scale(rgba, inW, inH, f);
+	if (bpp == 2)
+		fromRGBA<uint16>(_format, out, inW * f, kBorder * f, dstPtr, dstPitch, width * f, height * f);
+	else
+		fromRGBA<uint32>(_format, out, inW * f, kBorder * f, dstPtr, dstPitch, width * f, height * f);
+}
+
+uint XBRFScaler::increaseFactor() {
+	if (_factor < 4)
+		setFactor(_factor + 1);
+	return _factor;
+}
+
+uint XBRFScaler::decreaseFactor() {
+	if (_factor > 2)
+		setFactor(_factor - 1);
+	return _factor;
+}
+
+class XBRFPlugin final : public ScalerPluginObject {
+public:
+	XBRFPlugin() {
+		_factors.push_back(2);
+		_factors.push_back(3);
+		_factors.push_back(4);
+	}
+
+	Scaler *createInstance(const Graphics::PixelFormat &format) const override {
+		return new XBRFScaler(format);
+	}
+
+	bool canDrawCursor() const override { return false; }
+	uint extraPixels() const override { return kBorder; }
+	uint getDefaultFactor() const override { return 3; }
+	const char *getName() const override { return "xbrf"; }
+	const char *getPrettyName() const override { return "xBRF"; }
+};
+
+REGISTER_PLUGIN_STATIC(XBRF, PLUGIN_TYPE_SCALER, XBRFPlugin);
